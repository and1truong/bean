{
  "$defs": {
    "github_com_beanruntime_bean_internal_appir_MenuItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "type": "string"
        },
        "parent": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "route": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/github_com_beanruntime_bean_internal_appir_MenuTarget"
        },
        "weight": {
          "maximum": 1000,
          "minimum": -1000,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "github_com_beanruntime_bean_internal_appir_MenuOwner": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "github_com_beanruntime_bean_internal_appir_MenuTarget": {
      "additionalProperties": false,
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "view"
                ]
              },
              {
                "required": [
                  "display"
                ]
              }
            ]
          },
          "required": [
            "page"
          ]
        },
        {
          "not": {
            "required": [
              "page"
            ]
          },
          "required": [
            "view",
            "display"
          ]
        }
      ],
      "properties": {
        "display": {
          "type": "string"
        },
        "page": {
          "type": "string"
        },
        "view": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://bean.build/schemas/menu.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "bean/v1alpha1"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/github_com_beanruntime_bean_internal_appir_MenuItem"
      },
      "maxItems": 200,
      "type": "array"
    },
    "kind": {
      "const": "Menu"
    },
    "maxDepth": {
      "maximum": 3,
      "minimum": 3,
      "type": "integer"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": "string"
    },
    "namespace": {
      "type": "string"
    },
    "owner": {
      "$ref": "#/$defs/github_com_beanruntime_bean_internal_appir_MenuOwner"
    },
    "profile": {
      "enum": [
        "workspace"
      ],
      "type": "string"
    },
    "variant": {
      "enum": [
        "default",
        "line"
      ],
      "type": "string"
    }
  },
  "required": [
    "kind",
    "name"
  ],
  "title": "Bean Menu definition",
  "type": "object"
}
